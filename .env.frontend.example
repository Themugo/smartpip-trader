# ==============================================
# SmartPip Trader - Frontend Environment Variables
# ==============================================
# Copy this file to .env and fill in your values
# VITE_* variables are exposed to the frontend

# Supabase Configuration (Required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# API Configuration
VITE_API_URL=https://api.smartpip.trade
VITE_APP_URL=https://smartpip.trade

# Deriv API (Optional - for live trading)
# VITE_DERIV_API_TOKEN=your-deriv-api-token

# Optional: Analytics
# VITE_GA_ID=G-XXXXXXXXXX

# Optional: Error Tracking
# VITE_SENTRY_DSN=https://xxx@sentry.io/xxx
