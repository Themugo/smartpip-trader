# ==============================================
# SmartPip Trader - Frontend Environment Variables
# ==============================================
# Copy this file to .env and fill in your values.
# VITE_* variables are exposed to the browser bundle.
# Never commit .env to version control.

# ── Required ──────────────────────────────────────────────────
# Supabase project URL (from https://app.supabase.com → Settings → API)
VITE_SUPABASE_URL=

# Supabase anonymous/public key (from same page)
VITE_SUPABASE_ANON_KEY=

# ── Server-side Deriv Trading ────────────────────────────────
# Never put the Deriv token in VITE_* variables. The backend owns the broker session.
# DERIV_API_TOKEN= (configure on the backend only)

# Deriv application ID (default: 1089)
# VITE_DERIV_APP_ID=1089

# ── Frontend -> FastAPI backend ───────────────────────────────
# Required for production Vercel builds; leave empty for same-origin local development.
# Example: https://api.smartpip.trade
VITE_API_URL=

# ── Optional: Analytics ───────────────────────────────────────
# Google Analytics measurement ID
# VITE_GA_ID=G-XXXXXXXXXX

# ── Optional: Error Tracking ──────────────────────────────────
# Sentry DSN for frontend error reporting
# VITE_SENTRY_DSN=https://xxx@sentry.io/xxx
