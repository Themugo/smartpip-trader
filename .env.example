# SmartPip Trading System - Environment Variables Example
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to version control

# ===============================
# Deriv API Configuration
# ===============================
DERIV_API_TOKEN=your_deriv_api_token_here
DERIV_APP_ID=1089
DERIV_API_URL=wss://ws.binaryws.com/websockets/v3

# ===============================
# Application Configuration
# ===============================
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
APP_VERSION=2.1.0
INSTANCE_ID=instance-1
CORS_ORIGINS=*

# ===============================
# Currency Configuration
# ===============================
CURRENCY=KES
CURRENCY_API_KEY=your_currency_api_key_here

# ===============================
# Security Configuration
# ===============================
JWT_SECRET_KEY=your_jwt_secret_key_here_min_32_characters
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Input Sanitization
SANITIZATION_SECRET_KEY=your_sanitization_secret_key_here

# Database Encryption
DB_ENCRYPTION_KEY=your_db_encryption_key_here

# ===============================
# Redis Configuration (Optional)
# ===============================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0

# ===============================
# KMS Configuration (Optional)
# ===============================
KMS_PROVIDER=hashicorp  # Options: aws, azure, hashicorp
KMS_MASTER_KEY_ID=master-key
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net/
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=your_vault_token_here

# ===============================
# Email Notifications
# ===============================
NOTIFICATION_EMAIL=your_email@example.com
NOTIFICATION_EMAIL_PASSWORD=your_email_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true

# ===============================
# Telegram Notifications
# ===============================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ===============================
# Discord Notifications
# ===============================
DISCORD_WEBHOOK_URL=your_discord_webhook_url

# ===============================
# M-Pesa Configuration (Kenyan Market)
# ===============================
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=your_mpesa_shortcode
MPESA_PASSKEY=your_mpesa_passkey
MPESA_INITIATOR_NAME=your_mpesa_initiator_name
MPESA_INITIATOR_PASSWORD=your_mpesa_initiator_password
MPESA_ENVIRONMENT=sandbox  # Options: sandbox, production
MPESA_CALLBACK_URL=https://your-domain.com/mpesa/callback

# ===============================
# Compliance Configuration (Kenyan Market)
# ===============================
CMA_LICENSE_NUMBER=your_cma_license_number
CBK_APPROVED=true
BUSINESS_HOURS_START=08:00
BUSINESS_HOURS_END=17:00
TAX_RATE=0.20

# ===============================
# OpenTelemetry Configuration
# ===============================
OTLP_ENDPOINT=http://localhost:4317
OTLP_INSECURE=false
ENABLE_OTLP_METRICS=false
OTLP_METRICS_INTERVAL_MS=15000

# ===============================
# Docker Configuration
# ===============================
DOCKER_USERNAME=your_docker_username
DOCKER_PASSWORD=your_docker_password

# ===============================
# CI/CD Configuration
# ===============================
FLY_API_TOKEN=your_fly_api_token
SLACK_WEBHOOK=your_slack_webhook_url

# ===============================
# Rate Limiting Configuration
# ===============================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ===============================
# Trading Configuration
# ===============================
BASE_AMOUNT=1.0
MIN_CONFIDENCE=70
STOP_LOSS=50.0
TAKE_PROFIT=100.0
MAX_CONSECUTIVE_LOSSES=3
MAX_TRADES_PER_HOUR=10

# ===============================
# Zero-Loss Configuration
# ===============================
DAILY_LOSS_LIMIT_PERCENT=5.0
DAILY_LOSS_LIMIT_AMOUNT=100.0
CONSECUTIVE_LOSS_LIMIT=3
MIN_CONFIDENCE_THRESHOLD=85

# ===============================
# Logging Configuration
# ===============================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=logs/app.log

# ===============================
# Database Configuration
# ===============================
DATABASE_PATH=trading.db
DATABASE_BACKUP_PATH=backups/
DATABASE_BACKUP_INTERVAL_HOURS=24

# ===============================
# Health Check Configuration
# ===============================
HEALTH_CHECK_INTERVAL_SECONDS=30
HEALTH_CHECK_TIMEOUT_SECONDS=10
HEALTH_CHECK_START_PERIOD_SECONDS=5
HEALTH_CHECK_RETRIES=3

# ===============================
# WebSocket Configuration
# ===============================
WEBSOCKET_PING_INTERVAL_SECONDS=30
WEBSOCKET_RECONNECT_INTERVAL_SECONDS=5
WEBSOCKET_MAX_RECONNECT_ATTEMPTS=10

# ===============================
# Cache Configuration
# ===============================
CACHE_MAX_SIZE=1000
CACHE_TTL_SECONDS=5

# ===============================
# Performance Configuration
# ===============================
METRICS_MAX_HISTORY=1000
METRICS_REPORT_INTERVAL_SECONDS=60

# ===============================
# Chaos Engineering Configuration
# ===============================
CHAOS_ENABLED=false
CHAOS_PROBABILITY=0.1
CHAOS_DURATION_SECONDS=30
CHAOS_RECOVERY_TIME_SECONDS=60

# ===============================
# Monitoring Configuration
# ===============================
GRAFANA_URL=http://localhost:3000
PROMETHEUS_URL=http://localhost:9090
ANOMALY_DETECTION_ENABLED=true
ANOMALY_THRESHOLD_STD=3.0
ANOMALY_WINDOW_SIZE=100

# ===============================
# Security Headers
# ===============================
SECURE_HEADERS_ENABLED=true
CSP_ENABLED=true
HSTS_ENABLED=true
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff
