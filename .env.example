# ==============================================
# SmartPip Trader - Frontend Environment Variables
# ==============================================
# Copy this file to .env and fill in your values.
# VITE_* variables are exposed to the browser bundle.
# Never commit .env to version control.

# ── Required ──────────────────────────────────────────────────
# Supabase project URL (from https://app.supabase.com → Settings → API)
VITE_SUPABASE_URL=

# Supabase anonymous/public key (from same page)
VITE_SUPABASE_ANON_KEY=

# ── Optional: Deriv Trading ───────────────────────────────────
# Deriv API token for live/demo trading (from https://app.deriv.com/account/api-token)
# If omitted, user must enter token in the sidebar at runtime.
# VITE_DERIV_API_TOKEN=

# Deriv application ID (default: 1089)
# VITE_DERIV_APP_ID=1089

# ── Optional: API ─────────────────────────────────────────────
# Custom API base URL (defaults to Supabase Edge Functions)
# VITE_API_URL=

# ── Optional: Analytics ───────────────────────────────────────
# Google Analytics measurement ID
# VITE_GA_ID=G-XXXXXXXXXX

# ── Optional: Error Tracking ──────────────────────────────────
# Sentry DSN for frontend error reporting
# VITE_SENTRY_DSN=https://xxx@sentry.io/xxx
