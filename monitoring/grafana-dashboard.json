{
  "dashboard": {
    "title": "SmartPip Trading System - Security & Operations",
    "uid": "smartpip-security-dashboard",
    "tags": ["security", "trading", "monitoring"],
    "timezone": "browser",
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "System Health",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "up{job='smartpip-trader'}",
            "legendFormat": "{{instance}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "green", "value": 1}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Active Trades",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
        "targets": [
          {
            "expr": "active_trades",
            "legendFormat": "Active Trades"
          }
        ]
      },
      {
        "id": 3,
        "title": "Account Balance",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
        "targets": [
          {
            "expr": "account_balance",
            "legendFormat": "Balance"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD"
          }
        }
      },
      {
        "id": 4,
        "title": "WebSocket Connections",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "websocket_connections",
            "legendFormat": "Connections"
          }
        ]
      },
      {
        "id": 5,
        "title": "Trade Execution Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 4},
        "targets": [
          {
            "expr": "rate(trades_total[5m])",
            "legendFormat": "Trades/sec"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Trade Win/Loss Ratio",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 4},
        "targets": [
          {
            "expr": "trades_wins_total",
            "legendFormat": "Wins"
          },
          {
            "expr": "trades_losses_total",
            "legendFormat": "Losses"
          }
        ]
      },
      {
        "id": 7,
        "title": "API Latency",
        "type": "graph",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 12},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(api_latency_seconds_bucket[5m]))",
            "legendFormat": "95th Percentile"
          },
          {
            "expr": "histogram_quantile(0.50, rate(api_latency_seconds_bucket[5m]))",
            "legendFormat": "50th Percentile"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "id": 8,
        "title": "Trade Duration",
        "type": "graph",
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 12},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(trade_duration_seconds_bucket[5m]))",
            "legendFormat": "95th Percentile"
          },
          {
            "expr": "histogram_quantile(0.50, rate(trade_duration_seconds_bucket[5m]))",
            "legendFormat": "50th Percentile"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "id": 9,
        "title": "Security Events",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
        "targets": [
          {
            "expr": "rate(security_failed_logins_total[5m])",
            "legendFormat": "Failed Logins"
          },
          {
            "expr": "rate(security_xss_attempts_total[5m])",
            "legendFormat": "XSS Attempts"
          },
          {
            "expr": "rate(security_sql_injection_attempts_total[5m])",
            "legendFormat": "SQL Injection"
          },
          {
            "expr": "rate(security_replay_attacks_total[5m])",
            "legendFormat": "Replay Attacks"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "lineStyle": {"fill": "solid"}
            },
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 10,
        "title": "Kill Switch Activations",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 12, "y": 20},
        "targets": [
          {
            "expr": "kill_switch_activations_total",
            "legendFormat": "Activations"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 1},
                {"color": "red", "value": 5}
              ]
            }
          }
        }
      },
      {
        "id": 11,
        "title": "Rate Limit Blocks",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 16, "y": 20},
        "targets": [
          {
            "expr": "rate_limit_blocks_total",
            "legendFormat": "Blocks"
          }
        ]
      },
      {
        "id": 12,
        "title": "Active Sessions",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 20, "y": 20},
        "targets": [
          {
            "expr": "security_active_sessions",
            "legendFormat": "Sessions"
          }
        ]
      },
      {
        "id": 13,
        "title": "Trade Profit Distribution",
        "type": "heatmap",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
        "targets": [
          {
            "expr": "rate(trade_profit_amount_bucket[5m])",
            "legendFormat": "{{le}}"
          }
        ]
      },
      {
        "id": 14,
        "title": "System Errors",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
        "targets": [
          {
            "expr": "rate(system_errors_total[5m])",
            "legendFormat": "Errors/sec"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 10},
                {"color": "red", "value": 50}
              ]
            }
          }
        }
      },
      {
        "id": 15,
        "title": "Market Performance",
        "type": "table",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
        "targets": [
          {
            "expr": "trades_total by (market)",
            "format": "table",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {},
              "indexByName": {},
              "renameByName": {
                "Value": "Total Trades"
              }
            }
          }
        ]
      }
    ]
  }
}
