# ==============================================
# SmartPip Trader - Production Environment
# ==============================================
# This file documents all production environment variables
# DO NOT commit actual values - use this as a reference

# ===================
# FRONTEND (VITE_*)
# ===================
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=xxx
VITE_API_URL=https://api.smartpip.trade
VITE_APP_URL=https://smartpip.trade

# ===================
# BACKEND
# ===================
DATABASE_URL=postgresql://xxx
REDIS_URL=redis://xxx
JWT_SECRET=xxx
ENCRYPTION_KEY=xxx
SUPABASE_SERVICE_ROLE_KEY=xxx

# ===================
# BROKER
# ===================
DERIV_API_TOKEN=xxx
DERIV_APP_ID=1089

# ===================
# SECURITY
# ===================
SECRET_KEY=xxx
ALLOWED_HOSTS=smartpip.trade,www.smartpip.trade
CORS_ORIGINS=https://smartpip.trade,https://www.smartpip.trade

# ===================
# BILLING (Stripe)
# ===================
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PROFESSIONAL=price_xxx
STRIPE_PRICE_ENTERPRISE=price_xxx

# ===================
# MONITORING
# ===================
SENTRY_DSN=https://xxx@sentry.io/xxx
OTEL_EXPORTER_OTLP_ENDPOINT=http://xxx

# ===================
# DEPLOYMENT
# ===================
ENVIRONMENT=production
DEBUG=false
