# Deriv API Configuration
DERIV_API_TOKEN=your_real_api_token_here
DERIV_APP_ID=1089

# Environment
ENVIRONMENT=production
PRODUCTION_MODE=true

# Currency
CURRENCY=KES

# Trading Settings
BASE_AMOUNT=100
MAX_RISK_PER_TRADE=0.02
MIN_CONFIDENCE=85
MAX_DAILY_TRADES=50
MAX_POSITION_SIZE=10000

# Risk Management
DAILY_LOSS_LIMIT=0.05
MAX_CONSECUTIVE_LOSSES=3
KILL_SWITCH_ENABLED=true

# Security
SECRET_KEY=your_secret_key_here
ENCRYPTION_KEY=your_encryption_key_here
JWT_ENABLED=true
IP_WHITELIST_ENABLED=true
RATE_LIMIT_ENABLED=true
ENCRYPTION_ENABLED=true

# IP Security
WHITELISTED_IPS=your_ip_address_here
BLACKLISTED_IPS=

# API Security
API_KEYS=your_api_keys_here

# Server Configuration
PORT=8000

# Notification Configuration
NOTIFICATION_EMAIL=your_email@example.com
NOTIFICATION_EMAIL_PASSWORD=your_app_password

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

DISCORD_WEBHOOK_URL=your_discord_webhook_url

# M-Pesa Configuration
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=your_mpesa_shortcode
MPESA_PASSKEY=your_mpesa_passkey
MPESA_INITIATOR_NAME=your_mpesa_initiator_name
MPESA_ENVIRONMENT=production

# Compliance
CMA_LICENSE_NUMBER=your_cma_license_number
CBK_APPROVED=true
