# ==============================================
# SmartPip Trader - Backend Environment Variables
# ==============================================
# Copy this file to .env and fill in your values
# These variables are SERVER-SIDE ONLY - never expose to frontend

# Supabase Service Role (server-side)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
DATABASE_URL=postgresql://user:password@host:5432/database

# Supabase JWT Secret
JWT_SECRET=your-jwt-secret-min-32-chars

# Encryption Keys (generate secure random strings)
ENCRYPTION_KEY=your-encryption-key-min-32-chars
API_ENCRYPTION_KEY=your-api-encryption-key

# Deriv API Configuration
DERIV_API_TOKEN=your-deriv-api-token
DERIV_APP_ID=1089
DERIV_API_URL=wss://ws.binaryws.com/websockets/v3

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Feature Flags
ENABLE_SHADOW_MODE=true
ENABLE_BACKTESTING=true
ENABLE_ML_PREDICTIONS=true

# Monitoring
ENABLE_OTLP=false
OTLP_ENDPOINT=http://localhost:4317
